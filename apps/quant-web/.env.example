# 前端调后端的 4 个同源前缀（由 vite.config.ts 的 server.proxy 转发到 Python 服务）
VITE_DATA_QUERY_URL=/api/dq
VITE_SYNC_URL=/api/sync
VITE_SETTINGS_URL=/api/settings
VITE_ENGINE_URL=/api/engine

# 后端所在主机。本机开发留空即可（默认 127.0.0.1）；
# 后端部署在远端时填 IP/域名，dev server 会把 /api/* 代理过去。
# 浏览器始终同源访问 /api/*，因此不涉及 CORS。
VITE_API_HOST=

# 与 .quant.env 里的 QUANT_API_KEY 保持一致；生产环境请通过部署侧注入，不要提交真实 key。
VITE_QUANT_API_KEY=replace-with-the-local-admin-api-key

# 可选：量化助手（DSH Agent 宿主，默认取当前页面同主机名的 3081 端口）
VITE_ASSISTANT_URL=
